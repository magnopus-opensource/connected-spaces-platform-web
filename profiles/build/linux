# Build-context profile for Linux, used for anything Conan has to compile to run on the build machine
# (e.g. tool_requires built from source).
# Points at the versioned clang 18 binaries so a missing clang 18 fails loudly instead of silently
# compiling with a different compiler than compiler.version says.

[settings]
os=Linux
arch=x86_64
build_type=Release
compiler=clang
compiler.version=18
compiler.libcxx=libstdc++11
compiler.cppstd=20

[conf]
tools.build:compiler_executables={"c":"/usr/bin/clang-18","cpp":"/usr/bin/clang++-18"}
